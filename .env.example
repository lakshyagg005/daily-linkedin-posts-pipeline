# Fill in your own API keys — get them from each provider's dashboard
SLACK_BOT_TOKEN=
APIFY_API_KEY=
SCRAPINGDOG_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_TOKEN=

# LinkedIn API — OAuth 2.0 60-day Access Token for official automated publishing
# Obtain via developer.linkedin.com (products: "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect")
# Or run: python3 -m personal_brand.linkedin_auth_setup
LINKEDIN_ACCESS_TOKEN=
# Optional: urn:li:person:... override (auto-fetched from /v2/userinfo if left empty)
LINKEDIN_PERSON_URN=

# Cost Control: Set to true to enforce ₹0/month free-only mode (blocks paid models)
LLM_FREE_ONLY=true
